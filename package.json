{
  "name": "release-board",
  "version": "1.0.0",
  "scripts": {
    "dev": "vite",
    "emulators": "firebase emulators:start --project demo-release-board",
    "dev:emu": "VITE_USE_EMULATORS=1 vite",
    "seed:emu": "node scripts/seed-emulator.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "test:rules": "firebase emulators:exec --project demo-release-board --only firestore,storage \"vitest run tests/rules.test.js\""
  },
  "license": "UNLICENSED",
  "description": "Production release board: PR links and release notes per release",
  "dependencies": {
    "firebase": "^13.4.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "firebase-tools": "^15.36.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "private": true,
  "type": "module"
}
